// Mudaro · Modelo de datos (MVP sin cuenta de cliente), nombres en español
// SOLO PARA ANALIZAR. En el código y en Supabase todo va en inglés (tablas, columnas, enums).
// Cada tabla lleva su nombre real o previsto en inglés en la nota "EN:" y en un comentario.
// Las columnas llevan su nombre en inglés en un comentario al final de la línea.
//
// Estado de cada tabla:
//   [EXISTE]    ya está en supabase/migrations (paso 1 a 3 del plan)
//   [PROPUESTA] viene del documento de cambios (pedido y envío), aún sin migración
// Para ver el diagrama: dbdiagram.io > Import > DBML

Project mudaro {
  database_type: 'PostgreSQL'
  Note: 'Pedido = la mudanza. Envio = el pedido enviado a una empresa. Presupuesto = oferta de una empresa sobre una version del inventario del pedido. En el MVP cada pedido tiene un solo envio.'
}

// =====================================================================
// ENUMS
// =====================================================================

Enum rol_empresa {            // EN: company_role [EXISTE]
  administrador               // EN: administrator
  operario                    // EN: operator
}

Enum tipo_vehiculo {          // EN: vehicle_type [EXISTE]
  furgoneta_pequena           // EN: small-van
  furgoneta                   // EN: van
  camion_mediano              // EN: medium-truck
  camion_grande               // EN: large-truck
  otro                        // EN: other
}

Enum motivo_vehiculo_inactivo { // EN: vehicle_inactive_reason [EXISTE]
  taller                      // EN: workshop
  otro                        // EN: other
}

Enum idioma_app {             // EN: app_locale [EXISTE]
  pt
  es
  en
}

Enum marca_manipulacion {     // EN: handling_flag [EXISTE]
  fragil                      // EN: fragile
  desmontaje                  // EN: disassembly
  personal_extra              // EN: extra_crew
}

Enum modo_precio {            // EN: price_mode [PROPUESTA]
  fijo                        // EN: fixed
  unidad                      // EN: unit
  m3                          // EN: m3
  hora                        // EN: hour
}

Enum tipo_cliente {           // EN: client_type [PROPUESTA]
  particular                  // EN: private
  empresa                     // EN: company
}

Enum estado_envio {           // EN: shipment_status [PROPUESTA] (antes estado_solicitud)
  nueva                       // EN: new
  esperando_inventario        // EN: awaiting_inventory
  inventario_recibido         // EN: inventory_received
  presupuestada               // EN: quoted
  ganada                      // EN: won
  perdida                     // EN: lost
  cancelado                   // EN: cancelled (valor nuevo)
}

Enum tipo_direccion {         // EN: address_role [PROPUESTA]
  origen                      // EN: origin
  destino                     // EN: destination
  parada                      // EN: stop
}

Enum tipo_ascensor {          // EN: lift_size [PROPUESTA]
  no                          // EN: none
  pequeno                     // EN: small
  normal                      // EN: large
}

Enum rellenado_por {          // EN: filled_by [PROPUESTA]
  cliente                     // EN: client
  empresa                     // EN: company
}

Enum estado_presupuesto {     // EN: quote_status [PROPUESTA]
  borrador                    // EN: draft
  enviado                     // EN: sent
  aceptado                    // EN: accepted
  rechazado                   // EN: rejected
  caducado                    // EN: expired
  sustituido                  // EN: superseded
}

Enum origen_linea {           // EN: line_origin [PROPUESTA]
  calculada                   // EN: calculated
  manual                      // EN: manual
}

Enum estado_trabajo {         // EN: job_status [PROPUESTA]
  programado                  // EN: scheduled
  en_curso                    // EN: in_progress
  entregado                   // EN: delivered
  cerrado                     // EN: closed
  cancelado                   // EN: cancelled
}

Enum momento_trabajo {        // EN: job_moment [PROPUESTA]
  recogida                    // EN: pickup
  entrega                     // EN: delivery
  incidencia                  // EN: incident
}

Enum tipo_incidencia {        // EN: incident_type [PROPUESTA]
  dano                        // EN: damage
  no_declarado                // EN: undeclared
  retraso                     // EN: delay
  acceso                      // EN: access
}

// =====================================================================
// 1. EQUIPO MUDARO, EMPRESAS Y USUARIOS  [EXISTE]
// =====================================================================

Table usuarios_plataforma {   // EN: platform_users [EXISTE]
  id uuid [pk, note: 'Igual que auth.users.id']
  nombre text [not null]                                  // name
  activo boolean [not null, default: true]                // active
  creado_en timestamptz [not null, default: `now()`]      // created_at
  actualizado_en timestamptz [not null, default: `now()`] // updated_at
  Note: 'EN: platform_users. Equipo Mudaro. MFA obligatorio (aal2) en is_platform_user()'
}

Table empresas {              // EN: companies [EXISTE]
  id uuid [pk, default: `gen_random_uuid()`]
  nombre_comercial text [not null]                        // trade_name
  codigo_pais char(2) [not null, default: 'PT']           // country_code
  nif text [not null]                                     // tax_id
  telefono text                                           // phone
  email_general text                                      // general_email
  direccion_base text                                     // base_address
  ruta_logo text                                          // logo_path
  referencia_imt text                                     // imt_reference
  imt_verificado_el date                                  // imt_verified_on
  version_rgpd text                                       // gdpr_version
  rgpd_firmado_el date                                    // gdpr_signed_on
  desactivada_en timestamptz                              // deactivated_at
  motivo_desactivacion text                               // deactivation_reason
  creado_en timestamptz [not null, default: `now()`]      // created_at
  actualizado_en timestamptz [not null, default: `now()`] // updated_at

  indexes {
    (codigo_pais, nif) [unique]
  }
  Note: 'EN: companies. Zona horaria, plan y estado del borrador anterior no existen: el estado se calcula (RF-66)'
}

Table empresa_interna {       // EN: company_internal [EXISTE]
  empresa_id uuid [pk]                                    // company_id
  region text                                             // region
  origen text                                             // source
  notas text                                              // notes
  actualizado_en timestamptz [not null, default: `now()`] // updated_at
  Note: 'EN: company_internal. Notas del equipo Mudaro, RLS solo plataforma'
}

Table usuarios {              // EN: company_users [EXISTE]
  id uuid [pk, note: 'Igual que auth.users.id']
  empresa_id uuid [not null]                              // company_id
  rol rol_empresa [not null]                              // role
  nombre text [not null]                                  // name
  telefono text                                           // phone
  activo boolean [not null, default: true]                // active (RF-04)
  creado_en timestamptz [not null, default: `now()`]      // created_at
  actualizado_en timestamptz [not null, default: `now()`] // updated_at
  Note: 'EN: company_users. Un usuario pertenece a una sola empresa'
}

Table invitaciones {          // EN: invitations [EXISTE]
  id uuid [pk, default: `gen_random_uuid()`]
  empresa_id uuid [not null]                              // company_id
  email text [not null]                                   // email
  nombre text [not null]                                  // name
  rol rol_empresa [not null]                              // role
  enviada_en timestamptz                                  // sent_at
  caduca_en timestamptz [not null, note: 'Ahora + 7 dias']  // expires_at
  aceptada_en timestamptz                                 // accepted_at
  revocada_en timestamptz                                 // revoked_at
  creado_en timestamptz [not null, default: `now()`]      // created_at
  actualizado_en timestamptz [not null, default: `now()`] // updated_at
  Note: 'EN: invitations. No guarda token: lo genera Supabase Auth. Una sola invitacion pendiente de administrador por empresa'
}

Table auditoria {             // EN: audit_log [EXISTE]
  id bigint [pk, increment]
  ocurrido_en timestamptz [not null, default: `now()`]    // occurred_at
  actor_id uuid                                           // actor_id
  tipo_actor text [not null, note: 'platform, company o system']  // actor_type
  empresa_id uuid [note: 'Sin clave foranea a proposito']  // company_id
  accion text [not null]                                  // action
  entidad text [not null]                                 // entity
  entidad_id text [not null]                              // entity_id
  datos jsonb [not null, default: '{}']                   // data
  Note: 'EN: audit_log. Inmutable: sin update, delete ni truncate (RNF-08)'
}

// =====================================================================
// 2. CONFIGURACION DE LA EMPRESA
// =====================================================================

Table vehiculos {             // EN: vehicles [EXISTE]
  id uuid [pk, default: `gen_random_uuid()`]
  empresa_id uuid [not null]                              // company_id
  tipo tipo_vehiculo [not null]                           // type
  matricula text [not null, note: 'Formato AA-00-AA']     // plate
  nombre text                                             // name
  capacidad_m3 numeric(6,2) [not null]                    // capacity_m3
  carga_max_kg integer                                    // max_load_kg
  activo boolean [not null, default: true]                // active
  motivo_inactivo motivo_vehiculo_inactivo                // inactive_reason
  inactivo_desde date                                     // inactive_since
  inactivo_por uuid                                       // inactive_by
  creado_en timestamptz [not null, default: `now()`]      // created_at
  actualizado_en timestamptz [not null, default: `now()`] // updated_at

  indexes {
    (empresa_id, matricula) [unique]
  }
  Note: 'EN: vehicles'
}

Table costes_vehiculo {       // EN: vehicle_costs [EXISTE]
  vehiculo_id uuid [pk]                                   // vehicle_id
  empresa_id uuid [not null]                              // company_id
  coste_km_centimos integer [not null]                    // cost_per_km_cents
  actualizado_en timestamptz [not null, default: `now()`] // updated_at
  Note: 'EN: vehicle_costs. Solo administradores (RNF-03). El coste va en centimos'
}

Table tarifas {               // EN: tariffs [PROPUESTA, paso 2 pendiente]
  id uuid [pk, default: `gen_random_uuid()`]
  empresa_id uuid [not null]                              // company_id
  version integer [not null, note: 'Cada cambio de tarifa crea una version nueva']  // version
  precio_hora_operario numeric(10,2) [not null]           // operator_hour_price
  coste_hora_operario numeric(10,2) [not null]            // operator_hour_cost
  precio_km numeric(10,2) [not null]                      // km_price
  suplemento_piso_sin_ascensor numeric(10,2) [not null, default: 0]  // no_lift_floor_surcharge
  suplemento_aparcamiento numeric(10,2) [not null, default: 0]       // parking_surcharge
  minimo_servicio numeric(10,2) [not null, default: 0]    // minimum_service
  factor_estiba numeric(4,2) [not null, default: 1.20]    // stowage_factor
  velocidad_media_kmh numeric(5,1) [not null, default: 60]  // average_speed_kmh
  iva_pct numeric(4,2) [not null, default: 23]            // vat_pct
  vigente_desde timestamptz [not null, default: `now()`]  // valid_from

  indexes {
    (empresa_id, version) [unique]
  }
  Note: 'EN: tariffs (o tariff_versions). Los presupuestos enviados conservan la version usada (RF-06)'
}

Table servicios_extra {       // EN: company_extras [PROPUESTA, paso 2 pendiente]
  id uuid [pk, default: `gen_random_uuid()`]
  empresa_id uuid [not null]                              // company_id
  nombre text [not null]                                  // name
  modo_precio modo_precio [not null]                      // price_mode
  precio numeric(10,2) [not null]                         // price
  activo boolean [not null, default: true]                // active
  Note: 'EN: company_extras (RF-07)'
}

// =====================================================================
// 3. CATALOGO GLOBAL (sin empresa_id, lo mantiene Mudaro)  [EXISTE]
// =====================================================================

Table categorias_catalogo {   // EN: catalog_categories [EXISTE]
  id uuid [pk, default: `gen_random_uuid()`]
  slug text [not null, unique]                            // slug
  icono text                                              // icon
  orden integer [not null, default: 0]                    // sort_order
  activo boolean [not null, default: true]                // active
  creado_en timestamptz [not null, default: `now()`]      // created_at
  actualizado_en timestamptz [not null, default: `now()`] // updated_at
  Note: 'EN: catalog_categories'
}

Table traducciones_categoria_catalogo {  // EN: catalog_category_translations [EXISTE]
  categoria_id uuid [not null]                            // category_id
  idioma idioma_app [not null]                            // locale
  nombre text [not null]                                  // name
  descripcion text                                        // description

  indexes {
    (categoria_id, idioma) [pk]
  }
  Note: 'EN: catalog_category_translations'
}

Table habitaciones_catalogo { // EN: catalog_rooms [EXISTE]
  id uuid [pk, default: `gen_random_uuid()`]
  slug text [not null, unique]                            // slug
  icono text                                              // icon
  orden integer [not null, default: 0]                    // sort_order
  activo boolean [not null, default: true]                // active
  creado_en timestamptz [not null, default: `now()`]      // created_at
  actualizado_en timestamptz [not null, default: `now()`] // updated_at
  Note: 'EN: catalog_rooms. Salon, cocina, dormitorio...'
}

Table traducciones_habitacion_catalogo {  // EN: catalog_room_translations [EXISTE]
  habitacion_id uuid [not null]                           // room_id
  idioma idioma_app [not null]                            // locale
  nombre text [not null]                                  // name

  indexes {
    (habitacion_id, idioma) [pk]
  }
  Note: 'EN: catalog_room_translations'
}

Table objetos_catalogo {      // EN: catalog_items [EXISTE]
  id uuid [pk, default: `gen_random_uuid()`]
  slug text [not null, unique]                            // slug
  categoria_id uuid [not null]                            // category_id
  volumen_m3 numeric(6,3) [not null]                      // volume_m3
  dimension_max_cm integer                                // max_dimension_cm
  peso_kg numeric(7,2)                                    // weight_kg
  minutos_manipulacion integer [not null, default: 5]     // handling_minutes
  marcas_manipulacion marca_manipulacion[] [not null, default: '{}']  // handling_flags
  icono text                                              // icon
  orden integer [not null, default: 0]                    // sort_order
  activo boolean [not null, default: true]                // active
  creado_en timestamptz [not null, default: `now()`]      // created_at
  actualizado_en timestamptz [not null, default: `now()`] // updated_at
  Note: 'EN: catalog_items. Los booleanos fragil, desmontaje y especial del borrador pasan a marcas_manipulacion'
}

Table traducciones_objeto_catalogo {  // EN: catalog_item_translations [EXISTE]
  objeto_id uuid [not null]                               // item_id
  idioma idioma_app [not null]                            // locale
  nombre text [not null]                                  // name
  sinonimos text                                          // synonyms

  indexes {
    (objeto_id, idioma) [pk]
  }
  Note: 'EN: catalog_item_translations'
}

Table objetos_catalogo_habitaciones {  // EN: catalog_item_rooms [EXISTE]
  objeto_id uuid [not null]                               // item_id
  habitacion_id uuid [not null]                           // room_id

  indexes {
    (objeto_id, habitacion_id) [pk]
  }
  Note: 'EN: catalog_item_rooms. Un objeto puede salir en varias habitaciones'
}

Table objetos_empresa {       // EN: company_items [PROPUESTA]
  id uuid [pk, default: `gen_random_uuid()`]
  empresa_id uuid [not null]                              // company_id
  objeto_catalogo_id uuid                                 // catalog_item_id
  nombre text [not null]                                  // name
  volumen_m3 numeric(6,3) [not null]                      // volume_m3
  peso_kg numeric(7,2)                                    // weight_kg
  minutos_manipulacion integer                            // handling_minutes
  Note: 'EN: company_items. Ajustes propios de cada empresa sobre el catalogo global'
}

// =====================================================================
// 4. CLIENTES, PEDIDOS Y ENVIOS  [PROPUESTA]
// =====================================================================

Table clientes {              // EN: clients [PROPUESTA]
  id uuid [pk, default: `gen_random_uuid()`]
  empresa_id uuid [not null]                              // company_id
  nombre text [not null]                                  // name
  telefono text [note: 'Normalizado +351XXXXXXXXX']       // phone
  email text                                              // email
  nif text                                                // tax_id
  tipo tipo_cliente [not null, default: 'particular']     // type
  // Fase de cuentas: cuenta_id uuid (opcional)           // account_id
  Note: 'EN: clients. Ficha de contacto de cada empresa. Sin cuenta de cliente en el MVP'
}

Table pedidos {               // EN: orders [PROPUESTA] (sustituye a solicitudes)
  id uuid [pk, default: `gen_random_uuid()`]
  empresa_id uuid [not null, note: 'Empresa creadora y dueña del pedido. Con cuentas pasara a cuenta_id']  // company_id (creator)
  cliente_id uuid [not null, note: 'REVISAR: ver punto 1 al final']  // client_id
  fecha_deseada date                                      // desired_date
  flexibilidad_dias integer [not null, default: 0]        // flexibility_days
  token text [not null, unique, note: 'REVISAR: guardar hash, no el token (RNF-02)']  // token
  token_expira timestamptz [not null, note: '7 dias por defecto, reenviable']  // token_expires_at
  origen_contacto text                                    // contact_source
  cancelado boolean [not null, default: false]            // cancelled
  creado_en timestamptz [not null, default: `now()`]      // created_at
  // Fase de cuentas: cuenta_id uuid                      // account_id
  Note: 'EN: orders. La mudanza. Un enlace unico por pedido'
}

Table envios {                // EN: shipments [PROPUESTA] (nombre por decidir)
  id uuid [pk, default: `gen_random_uuid()`]
  empresa_id uuid [not null, note: 'Empresa destinataria']  // company_id
  pedido_id uuid [not null]                               // order_id
  estado estado_envio [not null, default: 'nueva']        // status
  creado_en timestamptz [not null, default: `now()`]      // created_at

  indexes {
    (pedido_id, empresa_id) [unique]
  }
  Note: 'EN: shipments. Un envio por empresa. En el MVP siempre hay uno por pedido (lo impone la app, no la BD)'
}

Table direcciones {           // EN: addresses [PROPUESTA]
  id uuid [pk, default: `gen_random_uuid()`]
  empresa_id uuid [not null]                              // company_id
  pedido_id uuid [not null]                               // order_id
  tipo tipo_direccion [not null]                          // role
  orden integer [not null, default: 0]                    // sort_order
  direccion text [not null]                               // address
  lat double                                              // lat
  lng double                                              // lng
  piso integer [not null, default: 0]                     // floor
  ascensor tipo_ascensor [not null, default: 'no']        // lift
  escaleras_estrechas boolean [not null, default: false]  // narrow_stairs
  distancia_aparcamiento_m integer [not null, default: 0] // parking_distance_m
  necesita_permiso boolean [not null, default: false]     // needs_permit
  notas text                                              // notes
  Note: 'EN: addresses. Cuelga del pedido. Los accesos (piso, ascensor, aparcamiento, escaleras) crean version nueva si cambian'
}

// =====================================================================
// 5. INVENTARIO (del pedido, versionado)  [PROPUESTA]
// =====================================================================

Table inventarios {           // EN: inventories [PROPUESTA]
  id uuid [pk, default: `gen_random_uuid()`]
  empresa_id uuid [not null, note: 'REVISAR: el inventario es del pedido, no de una empresa']  // company_id
  pedido_id uuid [not null]                               // order_id
  version integer [not null, note: 'Cambio de calculo o accesos = version nueva. Fotos y notas no']  // version
  rellenado_por rellenado_por [not null]                  // filled_by
  enviado_en timestamptz                                  // submitted_at

  indexes {
    (pedido_id, version) [unique]
  }
  Note: 'EN: inventories. Las versiones son de pedido, no de envio'
}

Table lineas_inventario {     // EN: inventory_lines [PROPUESTA]
  id uuid [pk, default: `gen_random_uuid()`]
  empresa_id uuid [not null]                              // company_id
  inventario_id uuid [not null]                           // inventory_id
  objeto_catalogo_id uuid                                 // catalog_item_id
  objeto_empresa_id uuid                                  // company_item_id
  descripcion text                                        // description
  habitacion text                                         // room
  cantidad integer [not null, default: 1]                 // quantity
  volumen_m3_unit numeric(6,3) [not null, note: 'Copia del catalogo al crearse']  // unit_volume_m3
  peso_kg_unit numeric(7,2)                               // unit_weight_kg
  minutos_unit integer [not null, default: 5]             // unit_minutes
  marcas_manipulacion marca_manipulacion[] [not null, default: '{}']  // handling_flags (antes fragil y desmontar)
  fotos text[] [not null, default: '{}']                  // photos
  Note: 'EN: inventory_lines'
}

Table inventario_extras {     // EN: inventory_extras [PROPUESTA]
  inventario_id uuid [not null]                           // inventory_id
  servicio_extra_id uuid [not null]                       // extra_id
  empresa_id uuid [not null]                              // company_id
  cantidad numeric(8,2) [not null, default: 1]            // quantity

  indexes {
    (inventario_id, servicio_extra_id) [pk]
  }
  Note: 'EN: inventory_extras. Servicios extra elegidos por el cliente (RF-24)'
}

// =====================================================================
// 6. PRESUPUESTOS Y ACEPTACION  [PROPUESTA]
// =====================================================================

Table presupuestos {          // EN: quotes [PROPUESTA] (antes propuestas, proposals)
  id uuid [pk, default: `gen_random_uuid()`]
  empresa_id uuid [not null]                              // company_id
  envio_id uuid [not null]                                // shipment_id
  inventario_id uuid [not null, note: 'Version exacta del inventario usada']  // inventory_id
  tarifa_id uuid [not null]                               // tariff_id
  version integer [not null]                              // version
  estado estado_presupuesto [not null, default: 'borrador']  // status
  volumen_m3 numeric(7,2)                                 // volume_m3
  n_vehiculos integer                                     // vehicle_count
  n_operarios integer                                     // operator_count
  horas_estimadas numeric(5,2)                            // estimated_hours
  km numeric(7,1)                                         // km
  coste_estimado numeric(10,2)                            // estimated_cost
  precio_sugerido numeric(10,2)                           // suggested_price
  precio_final numeric(10,2)                              // final_price
  iva_pct numeric(4,2) [not null]                         // vat_pct
  valido_hasta date                                       // valid_until
  condiciones text                                        // conditions
  snapshot jsonb [not null, default: '{}', note: 'Datos con los que se calculo']  // snapshot
  enviado_en timestamptz                                  // sent_at
  // REVISAR (punto 4): sustituye_a uuid                  // supersedes_id

  indexes {
    (envio_id, version) [unique]
  }
  Note: 'EN: quotes. Un presupuesto enviado no se edita: cambiarlo crea version nueva. El coste estimado solo lo ve el administrador (RNF-03)'
}

Table lineas_presupuesto {    // EN: quote_lines [PROPUESTA]
  id uuid [pk, default: `gen_random_uuid()`]
  empresa_id uuid [not null]                              // company_id
  presupuesto_id uuid [not null]                          // quote_id
  orden integer [not null, default: 0]                    // sort_order
  concepto text [not null]                                // description
  cantidad numeric(8,2) [not null, default: 1]            // quantity
  unidad text                                             // unit
  precio_unit numeric(10,2) [not null]                    // unit_price
  total numeric(10,2) [not null]                          // total
  origen origen_linea [not null, default: 'calculada']    // origin
  Note: 'EN: quote_lines'
}

Table aceptaciones {          // EN: acceptances [PROPUESTA]
  id uuid [pk, default: `gen_random_uuid()`]
  empresa_id uuid [not null]                              // company_id
  presupuesto_id uuid [not null, unique]                  // quote_id
  firmante text [not null]                                // signer_name
  firma_path text [not null]                              // signature_path
  ip inet                                                 // ip
  hash_documento text [not null]                          // document_hash
  aceptado_en timestamptz [not null, default: `now()`]    // accepted_at
  Note: 'EN: acceptances. Inmutable (RF-43)'
}

// =====================================================================
// 7. TRABAJO Y EJECUCION  [PROPUESTA]
// =====================================================================

Table trabajos {              // EN: jobs [PROPUESTA]
  id uuid [pk, default: `gen_random_uuid()`]
  empresa_id uuid [not null]                              // company_id
  presupuesto_id uuid [not null, unique]                  // quote_id
  estado estado_trabajo [not null, default: 'programado'] // status
  inicio_programado timestamptz [not null]                // scheduled_start
  fin_programado timestamptz                              // scheduled_end
  horas_reales numeric(5,2)                               // actual_hours
  km_reales numeric(7,1)                                  // actual_km
  notas text                                              // notes
  cerrado_en timestamptz                                  // closed_at
  Note: 'EN: jobs. Se crea al aceptar el presupuesto (RF-46)'
}

Table asignaciones {          // EN: assignments [PROPUESTA]
  id uuid [pk, default: `gen_random_uuid()`]
  empresa_id uuid [not null]                              // company_id
  trabajo_id uuid [not null]                              // job_id
  vehiculo_id uuid                                        // vehicle_id
  usuario_id uuid                                         // user_id
  periodo tstzrange [not null, note: 'Restriccion exclude impide solapes de vehiculo y usuario']  // period
  Note: 'EN: assignments'
}

Table incidencias {           // EN: incidents [PROPUESTA]
  id uuid [pk, default: `gen_random_uuid()`]
  empresa_id uuid [not null]                              // company_id
  trabajo_id uuid [not null]                              // job_id
  tipo tipo_incidencia [not null]                         // type
  descripcion text [not null]                             // description
  importe_extra numeric(10,2) [not null, default: 0]      // extra_amount
  aceptada_por_cliente boolean                            // accepted_by_client
  creado_en timestamptz [not null, default: `now()`]      // created_at
  Note: 'EN: incidents. Aqui se registra el cambio de inventario el dia de la mudanza, con importe y firma'
}

Table evidencias {            // EN: evidence [PROPUESTA]
  id uuid [pk, default: `gen_random_uuid()`]
  empresa_id uuid [not null]                              // company_id
  trabajo_id uuid [not null]                              // job_id
  linea_inventario_id uuid                                // inventory_line_id
  incidencia_id uuid                                      // incident_id
  momento momento_trabajo [not null]                      // moment
  archivo_path text [not null]                            // file_path
  tomada_en timestamptz [not null, default: `now()`]      // taken_at
  lat double                                              // lat
  lng double                                              // lng
  autor_id uuid                                           // author_id
  Note: 'EN: evidence. Fotos de la mudanza'
}

Table actas {                 // EN: handover_records [PROPUESTA]
  id uuid [pk, default: `gen_random_uuid()`]
  empresa_id uuid [not null]                              // company_id
  trabajo_id uuid [not null]                              // job_id
  momento momento_trabajo [not null]                      // moment
  firmante text [not null]                                // signer_name
  firma_path text [not null]                              // signature_path
  observaciones text                                      // remarks
  firmado_en timestamptz [not null, default: `now()`]     // signed_at

  indexes {
    (trabajo_id, momento) [unique]
  }
  Note: 'EN: handover_records (acta de entrega o recogida)'
}

// =====================================================================
// RELACIONES
// =====================================================================

// Empresa como inquilino
Ref: usuarios.empresa_id > empresas.id
Ref: invitaciones.empresa_id > empresas.id
Ref: empresa_interna.empresa_id - empresas.id
Ref: vehiculos.empresa_id > empresas.id
Ref: vehiculos.inactivo_por > usuarios.id
Ref: costes_vehiculo.vehiculo_id - vehiculos.id
Ref: tarifas.empresa_id > empresas.id
Ref: servicios_extra.empresa_id > empresas.id
Ref: objetos_empresa.empresa_id > empresas.id
Ref: clientes.empresa_id > empresas.id
Ref: pedidos.empresa_id > empresas.id
Ref: envios.empresa_id > empresas.id

// Catalogo
Ref: traducciones_categoria_catalogo.categoria_id > categorias_catalogo.id
Ref: traducciones_habitacion_catalogo.habitacion_id > habitaciones_catalogo.id
Ref: objetos_catalogo.categoria_id > categorias_catalogo.id
Ref: traducciones_objeto_catalogo.objeto_id > objetos_catalogo.id
Ref: objetos_catalogo_habitaciones.objeto_id > objetos_catalogo.id
Ref: objetos_catalogo_habitaciones.habitacion_id > habitaciones_catalogo.id
Ref: objetos_empresa.objeto_catalogo_id > objetos_catalogo.id

// Pedido y envio
Ref: pedidos.cliente_id > clientes.id
Ref: envios.pedido_id > pedidos.id
Ref: direcciones.pedido_id > pedidos.id

// Inventario
Ref: inventarios.pedido_id > pedidos.id
Ref: lineas_inventario.inventario_id > inventarios.id
Ref: lineas_inventario.objeto_catalogo_id > objetos_catalogo.id
Ref: lineas_inventario.objeto_empresa_id > objetos_empresa.id
Ref: inventario_extras.inventario_id > inventarios.id
Ref: inventario_extras.servicio_extra_id > servicios_extra.id

// Presupuesto
Ref: presupuestos.envio_id > envios.id
Ref: presupuestos.inventario_id > inventarios.id
Ref: presupuestos.tarifa_id > tarifas.id
Ref: lineas_presupuesto.presupuesto_id > presupuestos.id
Ref: aceptaciones.presupuesto_id - presupuestos.id
Ref: trabajos.presupuesto_id - presupuestos.id

// Ejecucion
Ref: asignaciones.trabajo_id > trabajos.id
Ref: asignaciones.vehiculo_id > vehiculos.id
Ref: asignaciones.usuario_id > usuarios.id
Ref: incidencias.trabajo_id > trabajos.id
Ref: evidencias.trabajo_id > trabajos.id
Ref: evidencias.linea_inventario_id > lineas_inventario.id
Ref: evidencias.incidencia_id > incidencias.id
Ref: evidencias.autor_id > usuarios.id
Ref: actas.trabajo_id > trabajos.id

// =====================================================================
// GRUPOS (colores en dbdiagram.io)
// =====================================================================

TableGroup base_existente [color: #777777] {
  usuarios_plataforma
  empresas
  empresa_interna
  usuarios
  invitaciones
  auditoria
}

TableGroup configuracion [color: #3D4A8F] {
  vehiculos
  costes_vehiculo
  tarifas
  servicios_extra
}

TableGroup catalogo_global [color: #2E7D6B] {
  categorias_catalogo
  traducciones_categoria_catalogo
  habitaciones_catalogo
  traducciones_habitacion_catalogo
  objetos_catalogo
  traducciones_objeto_catalogo
  objetos_catalogo_habitaciones
  objetos_empresa
}

TableGroup pedido_y_envio [color: #B5651D] {
  clientes
  pedidos
  envios
  direcciones
}

TableGroup inventario [color: #8A5A9E] {
  inventarios
  lineas_inventario
  inventario_extras
}

TableGroup presupuesto [color: #A33A3A] {
  presupuestos
  lineas_presupuesto
  aceptaciones
}

TableGroup ejecucion [color: #2A7F9E] {
  trabajos
  asignaciones
  incidencias
  evidencias
  actas
}

// =====================================================================
// PUNTOS A REVISAR (resumen de mi opinion anterior)
// =====================================================================
// 1. pedidos.cliente_id: la ficha es de una empresa. Con varias empresas por pedido
//    habria que guardar nombre y telefono en el pedido y mover cliente_id a envios.
// 2. RLS por envios.empresa_id y no por pedidos.empresa_id, para no tocar politicas despues.
// 3. Caducidad del enlace (7 dias) frente a valido_hasta del presupuesto: el cliente
//    debe poder aceptar mientras el presupuesto este vigente. Guardar hash del token.
// 4. Cambio tras aceptar: el presupuesto aceptado sigue vigente hasta que se acepte el nuevo.
//    Hace falta sustituye_a en presupuestos. El envio no vuelve atras de ganada.
// 5. Dinero: la BD real usa centimos (coste_km_centimos); este borrador usa numeric(10,2).
//    Hay que unificar antes de crear el paso 4.
// 6. Nombres en inglés: orders y shipments (shipment suena a mercancias, decidir ya).
// 7. empresa_id repetido en tablas hijas (inventarios, lineas, etc.) es para RLS simple (RNF-01),
//    pero inventarios y direcciones son del pedido: su RLS deberia pasar por envios.
