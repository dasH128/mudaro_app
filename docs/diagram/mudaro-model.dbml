// Mudaro · Modelo de datos (MVP sin cuenta de cliente), nombres en inglés
// Borrador para analizar. Es el modelo con los nombres que irán en Supabase.
// Cada enum, tabla, grupo y regla lleva encima un comentario en español.
//
// Estado de cada tabla:
//   [EXISTS]   ya está en supabase/migrations (pasos 1 a 3 del plan)
//   [PROPOSED] viene del documento de pedido y envío, aún sin migración
//
// Decisiones ya aplicadas respecto al documento original:
//   - client_id está en shipments, no en orders (una ficha por empresa)
//   - el enlace guarda el hash del token, no el token
//   - el dinero va en céntimos en todas las tablas, como en la base real
//   - quotes tiene supersedes_id para encadenar versiones tras la aceptación
//   - las tablas del pedido (addresses, inventories...) no llevan company_id: su RLS pasa por shipments
//   - la dirección (texto, coordenadas y accesos) se guarda por versión del inventario, en inventory_addresses (A1)
// Para ver el diagrama: dbdiagram.io > Import > DBML

// Resumen del proyecto: qué es cada entidad central.
Project mudaro {
  database_type: 'PostgreSQL'
  Note: 'Order = la mudanza. Shipment = el pedido enviado a una empresa. Quote = oferta de una empresa sobre una version del inventario del pedido. En el MVP cada pedido tiene un solo shipment.'
}

// =====================================================================
// ENUMS
// =====================================================================

// Rol de un usuario dentro de su empresa. [EXISTS]
Enum company_role {
  administrator
  operator
}

// Tipo de vehículo de la flota. [EXISTS]
Enum vehicle_type {
  "small-van"
  van
  "medium-truck"
  "large-truck"
  other
}

// Motivo por el que un vehículo está inactivo. [EXISTS]
Enum vehicle_inactive_reason {
  workshop
  other
}

// Idiomas de la interfaz y de las traducciones del catálogo. [EXISTS]
Enum app_locale {
  pt
  es
  en
}

// Marcas de manipulación de un objeto: frágil, desmontaje, personal extra. [EXISTS]
Enum handling_flag {
  fragile
  disassembly
  extra_crew
}

// Cómo se cobra un servicio extra: precio fijo, por unidad, por m3 o por hora. [PROPOSED]
Enum price_mode {
  fixed
  unit
  m3
  hour
}

// Tipo de cliente de una empresa: particular o empresa. [PROPOSED]
Enum client_type {
  private
  company
}

// Estado de un envío (antes estado_solicitud). El valor cancelled es nuevo. Un envío cancelado no se reactiva. [PROPOSED]
Enum shipment_status {
  new
  awaiting_inventory
  inventory_received
  quoted
  won
  lost
  cancelled
}

// Qué ocurrió en un envío, para la pestaña de historial. [PROPOSED]
Enum shipment_event_kind {
  created
  link_shared
  link_resent
  inventory_submitted
  quote_sent
  won
  lost
  cancelled
  note_added
}

// Margen de la fecha aproximada de la mudanza. month = el cliente solo sabe el mes. [PROPOSED]
Enum date_flexibility {
  exact
  two_days
  one_week
  month
}

// Función de una dirección dentro del pedido. [PROPOSED]
Enum address_role {
  origin
  destination
  stop
}

// Tamaño del ascensor en una dirección. [PROPOSED]
Enum lift_size {
  none
  small
  large
}

// Quién rellenó una versión del inventario: el cliente o la empresa. [PROPOSED]
Enum filled_by {
  client
  company
}

// Estado de un presupuesto. superseded = una versión nueva del inventario lo dejó obsoleto. [PROPOSED]
Enum quote_status {
  draft
  sent
  accepted
  rejected
  expired
  superseded
}

// Origen de una línea de presupuesto: calculada por la app o ajustada a mano. [PROPOSED]
Enum line_origin {
  calculated
  manual
}

// Estado de un trabajo (la mudanza ya aceptada). [PROPOSED]
Enum job_status {
  scheduled
  in_progress
  delivered
  closed
  cancelled
}

// Momento del trabajo al que pertenece una foto o un acta. [PROPOSED]
Enum job_moment {
  pickup
  delivery
  incident
}

// Tipo de incidencia durante la mudanza. [PROPOSED]
Enum incident_type {
  damage
  undeclared
  delay
  access
}

// =====================================================================
// 1. EQUIPO MUDARO, EMPRESAS Y USUARIOS  [EXISTS]
// =====================================================================

// Usuarios del equipo Mudaro (rol de plataforma). Separados de los usuarios de empresa. MFA obligatorio. [EXISTS]
Table platform_users {
  id uuid [pk, note: 'Igual que auth.users.id']
  name text [not null]
  active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// Empresas de mudanzas del piloto. El estado (convite pendente, ativa...) se calcula, no se guarda (RF-66). [EXISTS]
Table companies {
  id uuid [pk, default: `gen_random_uuid()`]
  trade_name text [not null]
  country_code char(2) [not null, default: 'PT']
  tax_id text [not null, note: 'El NIF en Portugal']
  phone text
  general_email text
  base_address text
  logo_path text
  imt_reference text [note: 'Licencia IMT']
  imt_verified_on date
  gdpr_version text
  gdpr_signed_on date
  deactivated_at timestamptz
  deactivation_reason text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (country_code, tax_id) [unique]
  }
}

// Notas internas del equipo Mudaro sobre una empresa. RLS solo para plataforma. [EXISTS]
Table company_internal {
  company_id uuid [pk]
  region text
  source text
  notes text
  updated_at timestamptz [not null, default: `now()`]
}

// Usuarios de una empresa (administrador u operario). Un usuario pertenece a una sola empresa. [EXISTS]
Table company_users {
  id uuid [pk, note: 'Igual que auth.users.id']
  company_id uuid [not null]
  role company_role [not null]
  name text [not null]
  phone text
  active boolean [not null, default: true, note: 'RF-04: un usuario inactivo no puede entrar']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// Invitaciones a usuarios de empresa. No guarda token: el enlace lo genera Supabase Auth. [EXISTS]
Table invitations {
  id uuid [pk, default: `gen_random_uuid()`]
  company_id uuid [not null]
  email text [not null]
  name text [not null]
  role company_role [not null]
  sent_at timestamptz
  expires_at timestamptz [not null, note: 'Ahora + 7 dias por defecto']
  accepted_at timestamptz
  revoked_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// Registro de auditoría de altas, invitaciones y cambios de estado (RNF-08). Inmutable. [EXISTS]
Table audit_log {
  id bigint [pk, increment]
  occurred_at timestamptz [not null, default: `now()`]
  actor_id uuid
  actor_type text [not null, note: 'platform, company o system']
  company_id uuid [note: 'Sin clave foranea a proposito, para sobrevivir a una empresa borrada']
  action text [not null]
  entity text [not null]
  entity_id text [not null]
  data jsonb [not null, default: '{}']
}

// =====================================================================
// 2. CONFIGURACIÓN DE LA EMPRESA
// =====================================================================

// Flota de cada empresa. La matrícula tiene formato AA-00-AA. [EXISTS]
Table vehicles {
  id uuid [pk, default: `gen_random_uuid()`]
  company_id uuid [not null]
  type vehicle_type [not null]
  plate text [not null]
  name text
  capacity_m3 numeric(6,2) [not null]
  max_load_kg integer
  active boolean [not null, default: true]
  inactive_reason vehicle_inactive_reason
  inactive_since date
  inactive_by uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (company_id, plate) [unique]
  }
}

// Coste por km de cada vehículo. Solo lo ven los administradores (RNF-03). [EXISTS]
Table vehicle_costs {
  vehicle_id uuid [pk]
  company_id uuid [not null]
  cost_per_km_cents integer [not null]
  updated_at timestamptz [not null, default: `now()`]
}

// Tarifas de la empresa, versionadas: cada cambio crea una versión nueva. Los presupuestos enviados conservan la usada (RF-06). [PROPOSED]
Table tariffs {
  id uuid [pk, default: `gen_random_uuid()`]
  company_id uuid [not null]
  version integer [not null]
  operator_hour_price_cents integer [not null]
  operator_hour_cost_cents integer [not null]
  km_price_cents integer [not null]
  no_lift_floor_surcharge_cents integer [not null, default: 0]
  parking_surcharge_cents integer [not null, default: 0]
  minimum_service_cents integer [not null, default: 0]
  stowage_factor numeric(4,2) [not null, default: 1.20]
  average_speed_kmh numeric(5,1) [not null, default: 60]
  vat_pct numeric(4,2) [not null, default: 23]
  valid_from timestamptz [not null, default: `now()`]

  indexes {
    (company_id, version) [unique]
  }
}

// Servicios extra de cada empresa (RF-07): montaje, embalaje, etc. [PROPOSED]
Table company_extras {
  id uuid [pk, default: `gen_random_uuid()`]
  company_id uuid [not null]
  name text [not null]
  price_mode price_mode [not null]
  price_cents integer [not null]
  active boolean [not null, default: true]
}

// =====================================================================
// 3. CATÁLOGO GLOBAL (sin company_id, lo mantiene Mudaro)  [EXISTS]
// =====================================================================

// Categorías de objetos del catálogo (mobiliario, electrodomésticos...). [EXISTS]
Table catalog_categories {
  id uuid [pk, default: `gen_random_uuid()`]
  slug text [not null, unique]
  icon text
  sort_order integer [not null, default: 0]
  active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// Nombre y descripción de cada categoría por idioma. [EXISTS]
Table catalog_category_translations {
  category_id uuid [not null]
  locale app_locale [not null]
  name text [not null]
  description text

  indexes {
    (category_id, locale) [pk]
  }
}

// Habitaciones del catálogo (salón, cocina, dormitorio...). [EXISTS]
Table catalog_rooms {
  id uuid [pk, default: `gen_random_uuid()`]
  slug text [not null, unique]
  icon text
  sort_order integer [not null, default: 0]
  active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// Nombre de cada habitación por idioma. [EXISTS]
Table catalog_room_translations {
  room_id uuid [not null]
  locale app_locale [not null]
  name text [not null]

  indexes {
    (room_id, locale) [pk]
  }
}

// Objetos del catálogo global con volumen, peso y minutos de manipulación. [EXISTS]
Table catalog_items {
  id uuid [pk, default: `gen_random_uuid()`]
  slug text [not null, unique]
  category_id uuid [not null]
  volume_m3 numeric(6,3) [not null]
  max_dimension_cm integer
  weight_kg numeric(7,2)
  handling_minutes integer [not null, default: 5]
  handling_flags handling_flag[] [not null, default: '{}']
  icon text
  sort_order integer [not null, default: 0]
  active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// Nombre y sinónimos de cada objeto por idioma (para el buscador). [EXISTS]
Table catalog_item_translations {
  item_id uuid [not null]
  locale app_locale [not null]
  name text [not null]
  synonyms text

  indexes {
    (item_id, locale) [pk]
  }
}

// En qué habitaciones puede aparecer cada objeto (relación muchos a muchos). [EXISTS]
Table catalog_item_rooms {
  item_id uuid [not null]
  room_id uuid [not null]

  indexes {
    (item_id, room_id) [pk]
  }
}

// Ajustes propios de cada empresa sobre un objeto del catálogo global. [PROPOSED]
Table company_items {
  id uuid [pk, default: `gen_random_uuid()`]
  company_id uuid [not null]
  catalog_item_id uuid
  name text [not null]
  volume_m3 numeric(6,3) [not null]
  weight_kg numeric(7,2)
  handling_minutes integer
}

// =====================================================================
// 4. CLIENTES, PEDIDOS Y ENVÍOS  [PROPOSED]
// =====================================================================

// Ficha de contacto de cada empresa. Privada de la empresa. Gana account_id opcional en la fase de cuentas. [PROPOSED]
Table clients {
  id uuid [pk, default: `gen_random_uuid()`]
  company_id uuid [not null]
  name text [not null]
  phone text [note: 'Normalizado +351XXXXXXXXX']
  email text
  tax_id text
  type client_type [not null, default: 'private']
  // Fase de cuentas: account_id uuid (opcional)

  indexes {
    (company_id, phone) [unique]
  }
}

// La mudanza (antes solicitud). Guarda el contacto declarado y el enlace del cliente. Dueño: la empresa creadora; con cuentas, account_id. [PROPOSED]
Table orders {
  id uuid [pk, default: `gen_random_uuid()`]
  created_by_company_id uuid [not null, note: 'Empresa que creo el pedido. Es la dueña mientras no haya cuenta; con cuentas, el dueño pasa a ser account_id y esta columna queda como historico. No es la ficha del cliente. La RLS de orders no usa esta columna: pasa por shipments']
  contact_name text [not null, note: 'Contacto declarado. La ficha de cada empresa vive en shipments.client_id']
  contact_phone text [not null, note: 'Normalizado +351XXXXXXXXX']
  desired_date date [not null, note: 'Fecha aproximada. Obligatoria (RF-13). Con date_flexibility = month solo importa el mes: se guarda el dia que escribio el usuario']
  date_flexibility date_flexibility [not null, default: 'exact', note: 'Margen de la fecha. Coincide con el enum del codigo (exact, two-days, one-week, month)']
  token_hash text [unique, note: 'Solo el hash del enlace, nunca el token (RNF-02). Nulo hasta que se comparte el enlace por primera vez: si la empresa rellena el inventario (RF-19) no hay enlace. Reenviar genera un token nuevo y el anterior deja de valer']
  token_expires_at timestamptz [note: '7 dias por defecto, configurable y reenviable. Nulo mientras no haya enlace. token_hash y token_expires_at van juntos: los dos nulos o los dos con valor. Caducado, solo bloquea editar el inventario: el cliente aun puede ver y aceptar un presupuesto vigente']
  contact_source text [note: 'Como llego el contacto: telefono, WhatsApp, recomendacion...']
  cancelled_at timestamptz [note: 'Cancelar el pedido cancela sus shipments vivos (RF-69). Solo lo rellena cancel_order()']
  cancellation_reason text
  cancelled_by_type text [note: 'Quien cancelo: company o client. Nulo si no esta cancelado. Con cuentas, cancela el dueño del pedido']
  cancelled_by_id uuid [note: 'Usuario de la empresa que cancelo. Nulo si cancelo el cliente por su enlace o si no esta cancelado']
  created_at timestamptz [not null, default: `now()`]
  // Fase de cuentas: account_id uuid
}

// El pedido enviado a una empresa (antes la parte de estado de solicitud). Un envío por empresa; en el MVP, uno por pedido. [PROPOSED]
Table shipments {
  id uuid [pk, default: `gen_random_uuid()`]
  company_id uuid [not null, note: 'Empresa destinataria']
  order_id uuid [not null]
  number integer [not null, note: 'Numero visible para la empresa (MD-0836 se arma en la interfaz). Secuencia propia de cada empresa, sin saltos. Pedido y envio comparten este numero para la empresa (RF-17). Los presupuestos cuelgan de el. El cliente no lo ve: con cuentas tendra orders.reference']
  client_id uuid [not null, note: 'Ficha del cliente en ESTA empresa: clients.company_id debe ser igual a shipments.company_id']
  status shipment_status [not null, default: 'new']
  lost_reason text [note: 'Solo si status = lost. Distinto de cancelled']
  status_changed_at timestamptz [not null, default: `now()`, note: 'Cuando cambio el estado por ultima vez. Lo actualiza la funcion que cambia el estado. Sirve para "lleva X dias esperando inventario" (RF-18) y para las cifras del mes (ganados, perdidos)']
  last_activity_at timestamptz [not null, default: `now()`, note: 'Ultimo evento relevante: inventario enviado, presupuesto enviado, aceptacion, nota. Lo actualiza un trigger al insertar una fila en shipment_events, no set_updated_at (que solo salta si cambia esta fila). Alimenta "sin novedades hace X dias" y el orden de la lista']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (order_id, company_id) [unique]
    (company_id, number) [unique]
  }
}

// Notas internas de la empresa sobre un envío. Las escribe una persona y se pueden editar o borrar (RGPD). Privadas de cada empresa: cuelgan del envío, no del pedido. [PROPOSED]
Table shipment_notes {
  id uuid [pk, default: `gen_random_uuid()`]
  company_id uuid [not null, note: 'Repetido a proposito para la RLS (RNF-01). Debe ser igual a shipments.company_id']
  shipment_id uuid [not null]
  author_id uuid [not null, note: 'Usuario de la empresa que la escribio']
  body text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// Historial del envío: lo que ocurrió y cuándo. Solo se escribe desde las funciones que hacen el cambio, nunca se edita ni se borra. Alimenta la pestaña de historial y last_activity_at. [PROPOSED]
Table shipment_events {
  id uuid [pk, default: `gen_random_uuid()`]
  company_id uuid [not null, note: 'Repetido a proposito para la RLS (RNF-01). Debe ser igual a shipments.company_id']
  shipment_id uuid [not null]
  kind shipment_event_kind [not null]
  actor_type text [not null, note: 'company, client o system. El cliente actua por el enlace y no tiene usuario']
  actor_id uuid [note: 'Usuario de la empresa. Nulo si actua el cliente o el sistema']
  data jsonb [not null, default: '{}', note: 'Datos del evento: dias de validez del enlace, version del inventario o del presupuesto, motivo. note_added guarda solo note_id, nunca el texto de la nota']
  occurred_at timestamptz [not null, default: `now()`]
}

// Las direcciones que tiene un pedido (origen, destino y paradas), solo como "huecos": qué función cumple cada una y en qué orden. No guarda el texto ni los accesos: eso cambia con las versiones y vive en inventory_addresses. Cuelga del pedido. [PROPOSED]
Table addresses {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null]
  role address_role [not null]
  sort_order integer [not null, default: 0]
}

// =====================================================================
// 5. INVENTARIO (del pedido, versionado)  [PROPOSED]
// =====================================================================

// Versión del inventario de un pedido. Un cambio de cálculo, de direcciones o de accesos crea versión nueva; fotos y notas no. Una fila sin submitted_at es el borrador, que se edita en sitio (ver A10). [PROPOSED]
Table inventories {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null, note: 'El inventario es del pedido, no del envio']
  version integer [not null]
  filled_by filled_by [not null]
  submitted_at timestamptz [note: 'Nulo = borrador editable. Con valor = version cerrada, no se edita']

  indexes {
    (order_id, version) [unique]
  }
}

// Objetos del inventario con volumen y peso copiados del catálogo al crearse. [PROPOSED]
Table inventory_lines {
  id uuid [pk, default: `gen_random_uuid()`]
  inventory_id uuid [not null]
  catalog_item_id uuid
  company_item_id uuid
  description text
  room text
  quantity integer [not null, default: 1]
  unit_volume_m3 numeric(6,3) [not null]
  unit_weight_kg numeric(7,2)
  unit_minutes integer [not null, default: 5]
  handling_flags handling_flag[] [not null, default: '{}']
  photos text[] [not null, default: '{}']
}

// Datos de cada dirección en una versión del inventario: texto, coordenadas y accesos. Como viven aquí, cambiar el destino, el piso o el ascensor crea una versión nueva y la versión anterior conserva lo que tenía (A1). [PROPOSED]
Table inventory_addresses {
  id uuid [pk, default: `gen_random_uuid()`]
  inventory_id uuid [not null, note: 'Version del inventario a la que pertenece']
  address_id uuid [not null, note: 'Hueco del pedido (origen, destino o parada) al que corresponde']
  address text [not null]
  lat double
  lng double
  floor integer [not null, default: 0]
  lift lift_size [not null, default: 'none']
  narrow_stairs boolean [not null, default: false]
  parking_distance_m integer [not null, default: 0]
  needs_permit boolean [not null, default: false]
  notes text

  indexes {
    (inventory_id, address_id) [unique]
  }
}

// Servicios extra elegidos por el cliente en una versión del inventario (RF-24). [PROPOSED]
Table inventory_extras {
  inventory_id uuid [not null]
  extra_id uuid [not null, note: 'PENDIENTE DE ANALISIS: company_extras es de cada empresa y el inventario es del pedido. Opciones: catalogo global de tipos de extra (con precio por empresa) o elegir los extras al presupuestar']
  quantity numeric(8,2) [not null, default: 1]

  indexes {
    (inventory_id, extra_id) [pk]
  }
}

// =====================================================================
// 6. PRESUPUESTOS Y ACEPTACIÓN  [PROPOSED]
// =====================================================================

// Oferta de una empresa para un envío, calculada sobre una versión del inventario. Una vez enviada no se edita; cambiarla crea versión nueva. [PROPOSED]
Table quotes {
  id uuid [pk, default: `gen_random_uuid()`]
  company_id uuid [not null, note: 'Repetido a proposito para la RLS (RNF-01)']
  shipment_id uuid [not null]
  inventory_id uuid [not null, note: 'Version exacta del inventario usada']
  tariff_id uuid [not null]
  version integer [not null]
  supersedes_id uuid [note: 'Presupuesto al que sustituye. Un aceptado sigue vigente hasta que se acepte el nuevo']
  status quote_status [not null, default: 'draft']
  volume_m3 numeric(7,2)
  vehicle_count integer
  operator_count integer
  estimated_hours numeric(5,2)
  km numeric(7,1)
  estimated_cost_cents bigint [note: 'Solo administradores (RNF-03)']
  suggested_price_cents bigint
  final_price_cents bigint
  vat_pct numeric(4,2) [not null]
  valid_until date
  conditions text
  snapshot jsonb [not null, default: '{}', note: 'Datos con los que se calculo']
  sent_at timestamptz

  indexes {
    (shipment_id, version) [unique]
  }
}

// Líneas de un presupuesto (conceptos, cantidades, precios), calculadas o manuales. [PROPOSED]
Table quote_lines {
  id uuid [pk, default: `gen_random_uuid()`]
  quote_id uuid [not null]
  sort_order integer [not null, default: 0]
  description text [not null]
  quantity numeric(8,2) [not null, default: 1]
  unit text
  unit_price_cents bigint [not null]
  total_cents bigint [not null]
  origin line_origin [not null, default: 'calculated']
}

// Aceptación del presupuesto por el cliente: firma, IP y huella del documento. Inmutable (RF-43). [PROPOSED]
Table acceptances {
  id uuid [pk, default: `gen_random_uuid()`]
  quote_id uuid [not null, unique]
  signer_name text [not null]
  signature_path text [not null]
  ip inet
  document_hash text [not null]
  accepted_at timestamptz [not null, default: `now()`]
}

// =====================================================================
// 7. TRABAJO Y EJECUCIÓN  [PROPOSED]
// =====================================================================

// La mudanza aceptada. Se crea al aceptar el presupuesto (RF-46). No se recrea si hay un presupuesto nuevo. [PROPOSED]
Table jobs {
  id uuid [pk, default: `gen_random_uuid()`]
  company_id uuid [not null]
  quote_id uuid [not null, unique, note: 'Presupuesto aceptado vigente. Se actualiza si el cliente acepta uno nuevo antes de la mudanza']
  status job_status [not null, default: 'scheduled']
  scheduled_start timestamptz [not null]
  scheduled_end timestamptz
  actual_hours numeric(5,2)
  actual_km numeric(7,1)
  notes text
  closed_at timestamptz
}

// Asignación de vehículos y operarios a un trabajo en un periodo. [PROPOSED]
Table assignments {
  id uuid [pk, default: `gen_random_uuid()`]
  company_id uuid [not null]
  job_id uuid [not null]
  vehicle_id uuid
  user_id uuid
  period tstzrange [not null, note: 'Una restriccion exclude impide solapes de vehiculo y de usuario']
}

// Incidencias durante la mudanza. Un cambio de inventario el día de la mudanza se registra aquí, con importe y firma. [PROPOSED]
Table incidents {
  id uuid [pk, default: `gen_random_uuid()`]
  company_id uuid [not null]
  job_id uuid [not null]
  type incident_type [not null]
  description text [not null]
  extra_amount_cents bigint [not null, default: 0]
  accepted_by_client boolean
  created_at timestamptz [not null, default: `now()`]
}

// Fotos de la mudanza (recogida, entrega, incidencias) con hora y ubicación. [PROPOSED]
Table evidence {
  id uuid [pk, default: `gen_random_uuid()`]
  company_id uuid [not null]
  job_id uuid [not null]
  inventory_line_id uuid
  incident_id uuid
  moment job_moment [not null]
  file_path text [not null]
  taken_at timestamptz [not null, default: `now()`]
  lat double
  lng double
  author_id uuid
}

// Actas firmadas de recogida y de entrega. Una por trabajo y momento. [PROPOSED]
Table handover_records {
  id uuid [pk, default: `gen_random_uuid()`]
  company_id uuid [not null]
  job_id uuid [not null]
  moment job_moment [not null]
  signer_name text [not null]
  signature_path text [not null]
  remarks text
  signed_at timestamptz [not null, default: `now()`]

  indexes {
    (job_id, moment) [unique]
  }
}

// =====================================================================
// RELACIONES
// =====================================================================

// Cada tabla de configuración y de gestión cuelga de su empresa (inquilino, RNF-01).
Ref: company_users.company_id > companies.id
Ref: invitations.company_id > companies.id
Ref: company_internal.company_id - companies.id
Ref: vehicles.company_id > companies.id
Ref: vehicles.inactive_by > company_users.id
Ref: vehicle_costs.vehicle_id - vehicles.id
Ref: tariffs.company_id > companies.id
Ref: company_extras.company_id > companies.id
Ref: company_items.company_id > companies.id
Ref: clients.company_id > companies.id
Ref: orders.created_by_company_id > companies.id
Ref: shipments.company_id > companies.id

// El catálogo global: categorías, habitaciones, objetos y sus traducciones.
Ref: catalog_category_translations.category_id > catalog_categories.id
Ref: catalog_room_translations.room_id > catalog_rooms.id
Ref: catalog_items.category_id > catalog_categories.id
Ref: catalog_item_translations.item_id > catalog_items.id
Ref: catalog_item_rooms.item_id > catalog_items.id
Ref: catalog_item_rooms.room_id > catalog_rooms.id
Ref: company_items.catalog_item_id > catalog_items.id

// Pedido, envío y ficha de cliente: el envío une el pedido con la ficha de la empresa.
Ref: shipments.order_id > orders.id
Ref: shipments.client_id > clients.id
Ref: addresses.order_id > orders.id

// Notas e historial del envío.
Ref: shipment_notes.shipment_id > shipments.id
Ref: shipment_notes.author_id > company_users.id
Ref: shipment_notes.company_id > companies.id
Ref: shipment_events.shipment_id > shipments.id
Ref: shipment_events.actor_id > company_users.id
Ref: shipment_events.company_id > companies.id

// Inventario versionado del pedido y sus líneas.
Ref: inventories.order_id > orders.id
Ref: inventory_lines.inventory_id > inventories.id
Ref: inventory_lines.catalog_item_id > catalog_items.id
Ref: inventory_lines.company_item_id > company_items.id
Ref: inventory_addresses.inventory_id > inventories.id
Ref: inventory_addresses.address_id > addresses.id
Ref: inventory_extras.inventory_id > inventories.id
Ref: inventory_extras.extra_id > company_extras.id

// Presupuesto: cuelga del envío, de una versión del inventario y de una versión de tarifa.
Ref: quotes.shipment_id > shipments.id
Ref: quotes.inventory_id > inventories.id
Ref: quotes.tariff_id > tariffs.id
Ref: quotes.supersedes_id > quotes.id
Ref: quote_lines.quote_id > quotes.id
Ref: acceptances.quote_id - quotes.id
Ref: jobs.quote_id - quotes.id

// Ejecución de la mudanza: asignaciones, incidencias, fotos y actas.
Ref: assignments.job_id > jobs.id
Ref: assignments.vehicle_id > vehicles.id
Ref: assignments.user_id > company_users.id
Ref: incidents.job_id > jobs.id
Ref: evidence.job_id > jobs.id
Ref: evidence.inventory_line_id > inventory_lines.id
Ref: evidence.incident_id > incidents.id
Ref: evidence.author_id > company_users.id
Ref: handover_records.job_id > jobs.id

// =====================================================================
// GRUPOS (colores en dbdiagram.io)
// =====================================================================

// Equipo Mudaro, empresas, usuarios, invitaciones y auditoría.
TableGroup base_existing [color: #777777] {
  platform_users
  companies
  company_internal
  company_users
  invitations
  audit_log
}

// Flota, tarifas y servicios extra de cada empresa.
TableGroup configuration [color: #3D4A8F] {
  vehicles
  vehicle_costs
  tariffs
  company_extras
}

// Catálogo global de objetos y los ajustes de cada empresa.
TableGroup global_catalog [color: #2E7D6B] {
  catalog_categories
  catalog_category_translations
  catalog_rooms
  catalog_room_translations
  catalog_items
  catalog_item_translations
  catalog_item_rooms
  company_items
}

// Clientes, pedidos, envíos y direcciones.
TableGroup order_and_shipment [color: #B5651D] {
  clients
  orders
  shipments
  shipment_notes
  shipment_events
  addresses
}

// Inventario versionado del pedido.
TableGroup inventory [color: #8A5A9E] {
  inventories
  inventory_lines
  inventory_addresses
  inventory_extras
}

// Presupuestos y su aceptación.
TableGroup quoting [color: #A33A3A] {
  quotes
  quote_lines
  acceptances
}

// Trabajo, asignaciones, incidencias, fotos y actas.
TableGroup execution [color: #2A7F9E] {
  jobs
  assignments
  incidents
  evidence
  handover_records
}

// =====================================================================
// FUNCIONES, TRIGGERS Y REGLAS (no son DBML; se documentan aquí para el análisis)
// =====================================================================

// Funciones y triggers que ya existen en supabase/migrations (nombres tal como están en las migraciones):
// is_platform_user(): true si quien llama es del equipo Mudaro y tiene MFA (aal2). Base de las políticas de plataforma. [EXISTS]
// current_company_id(): devuelve la empresa del usuario autenticado. Base de las políticas RLS por company_id. [EXISTS]
// is_company_administrator(): true si quien llama es administrador activo de una empresa activa. [EXISTS]
// set_updated_at(): función de trigger que actualiza updated_at. Hay un trigger por tabla (platform_users, companies, company_internal, company_users, invitations, vehicles, vehicle_costs, catalog_*). [EXISTS]
// is_valid_tax_id(): valida el dígito de control del NIF cuando el país es PT. Sustituye a is_valid_nif, que la migración 20261025100400 renombró. [EXISTS]
// create_company_with_invitation(): crea la empresa y su invitación de administrador (la usa la Edge Function create-company). [EXISTS]
// accept_invitation(): crea la fila de company_users con la sesión de quien canjeó el enlace y marca la invitación como aceptada. security definer. [EXISTS]
// create_vehicle(): crea un vehículo y su coste; solo el administrador; la empresa sale de la sesión. [EXISTS]
// block_audit_log_changes(): función de trigger que impide update, delete y truncate en audit_log (RNF-08). Triggers audit_log_block_update_delete y audit_log_block_truncate. [EXISTS]
// block_slug_change(): función de trigger que impide cambiar el slug del catálogo. Un trigger en categorías, habitaciones y objetos. [EXISTS]
// array_has_no_duplicates(): comprueba que handling_flags no repita valores. [EXISTS]
// f_unaccent(): quita acentos para el buscador del catálogo. [EXISTS]
// search_catalog_items(): busca objetos del catálogo por nombre o sinónimo en un idioma. [EXISTS]
// Edge Functions en supabase/functions: create-company (alta de empresa) y resend-invite (reenviar invitación). [EXISTS]
//
// Pendientes para el paso 4 y siguientes:
// Fechas de actividad del envío: status_changed_at se actualiza en cada cambio de estado (misma función que lo cambia). last_activity_at se actualiza con un trigger al insertar un shipment_events. Un borrador de inventario guardado por el cliente no cambia la fila de shipments, por eso no basta con updated_at. [PROPOSED]
// Numeración de envíos: shipments.number lo asigna create_order() con el siguiente número de la empresa (contador propio, bloqueado para evitar duplicados). Nunca se reutiliza ni se reasigna. El número de pedido que ve el cliente no existe en el MVP: con cuentas se añade orders.reference, un código corto no secuencial. Pendiente: prefijo de la numeración de presupuestos (hoy PR-xxxx). [PROPOSED]
// Restricción shipments.client_id: la ficha debe ser de la misma empresa. Clave compuesta (clients id + company_id, shipments client_id + company_id) o trigger. [PROPOSED]
// Trigger de nueva versión de inventario: si cambian objetos, cantidades, volúmenes, pesos, direcciones (texto o coordenadas) o accesos, crea una versión y pasa a superseded los presupuestos enviados que usaban la anterior. Solo actúa sobre versiones ya enviadas: el borrador se edita en sitio (A10). [PROPOSED]
// Regla tras aceptar: el presupuesto aceptado sigue vigente hasta que se acepte el nuevo; el envío no vuelve atrás de won y el trabajo no se recrea. [PROPOSED]
// Cancelación (RF-69): cancel_order() cancela el pedido y sus envíos vivos, y su trabajo si está scheduled (se bloquea si está in_progress o delivered). Autoriza por dueño del pedido y avisa a las demás empresas con envío vivo. Un envío cancelado no se reactiva. Detalle en A4. [PROPOSED]
// Restricción check en orders: token_hash y token_expires_at están los dos o ninguno. Un pedido sin enlace (inventario rellenado por la empresa) los tiene nulos hasta que se comparte el enlace. [PROPOSED]
// Caducidad del enlace: bloquea editar el inventario, no ver ni aceptar un presupuesto vigente. Edge Function que valida el hash del token (RNF-02). [PROPOSED]
// Restricción exclude en assignments: sin solapes de vehículo ni de usuario en el mismo periodo. [PROPOSED]
// Caducidad automática de presupuestos: pasado valid_until no se puede aceptar (RF-45). [PROPOSED]
// RLS de orders, addresses, inventories, inventory_lines e inventory_addresses: se lee solo si la empresa tiene un shipment en ese pedido. [PROPOSED]
// create_order(): además de crear el pedido y su envío, crea la versión 1 del inventario en borrador con las filas de addresses y los datos de origen y destino en inventory_addresses, porque el texto de la dirección ya no vive en addresses (A1). [PROPOSED]
//
// =====================================================================
// PENDIENTES (revisión del 09/11/2026). Cada punto lleva un código para citarlo.
// =====================================================================
//
// A. Correcciones acordadas, aún sin aplicar en este DBML
// A1 (APLICADO el 09/11/2026, versión ampliada) Direcciones y accesos sin versionar. RF-27 dice que cambiar piso, ascensor, aparcamiento o escaleras crea una versión nueva del inventario, pero esos campos estaban en addresses, que cuelga del pedido y se edita en sitio. Así el trigger de versión no veía el cambio y el anexo del presupuesto (RF-39) no podía mostrar la versión exacta. Además, cambiar el destino a otro más lejos cambia los km y el precio (RF-34) y tampoco creaba versión. Ahora addresses solo guarda role y sort_order, y el texto, las coordenadas y los accesos viven en inventory_addresses, ligada a inventories. Cambiar el destino, el piso o el ascensor crea una versión nueva y la anterior conserva lo que tenía. Consecuencias: create_order() crea la versión 1 en borrador con las direcciones; el 4a del paso 4 necesita inventories e inventory_addresses (ver D2); RF-27 incluye las direcciones; el borrador se edita en sitio (A10).
// A2 inventory_lines no cubre lo que piden los requisitos: falta la marca de revisión (objeto libre sin medidas, RF-21 y RF-36), el valor ajustado a mano (RF-37) y la marca "la base cambió" (RF-27). Decidir además dónde vive el ajuste manual: el inventario es del pedido y el ajuste de una empresa no debe afectar a otra cuando haya varias.
// A3 (APLICADO el 09/11/2026) orders.desired_date es not null (el formulario la exige, RF-13) y flexibility_days se sustituyó por el enum date_flexibility. Motivo: month significa "solo sé el mes", no 30 días de margen. Pendiente: fijar en el comentario del enum si el margen de two_days y one_week es antes, después o a ambos lados de la fecha (lo define el texto de la pantalla). Mejora de producto, no necesaria para el MVP: el formulario obliga a escribir una fecha completa aunque se elija "Só o mês"; podría pedir solo el mes y guardar el día 1.
// A4 (DECIDIDO el 09/11/2026, falta implementarlo en SQL) La cancelación vive en dos sitios (orders.cancelled_at y shipments.status) y solo debe cambiarla cancel_order(), en una transacción: (1) autoriza por dueño del pedido, que es account_id si existe y, si no, created_by_company_id; una empresa que solo tiene un envío en un pedido ajeno no puede cancelarlo; en el MVP cancela un administrador de la empresa creadora; (2) rellena orders.cancelled_at, cancellation_reason, cancelled_by_type y cancelled_by_id; (3) pasa a cancelled solo los envíos aún vivos (new, awaiting_inventory, inventory_received, quoted, won) y actualiza status_changed_at; (4) si un envío estaba won, cancela su trabajo cuando está scheduled y bloquea toda la cancelación si el trabajo está in_progress o delivered; (5) inserta el evento cancelled en shipment_events de cada envío y una fila en audit_log; (6) avisa a las empresas con envío vivo salvo a la que canceló (en el MVP, a nadie). Un trigger en shipments impide salir de cancelled. La aceptación de un presupuesto rechaza los envíos cancelados, sin añadir un valor a quote_status.
// A5 (APLICADO el 09/11/2026) orders.company_id se renombró a created_by_company_id y la excepción quedó escrita en RNF-01 (requirement-mvp.md): orders, addresses, inventories, inventory_lines e inventory_extras no llevan company_id propio y su RLS pasa por shipments. El dueño del pedido es account_id cuando exista (tras la reclamación) y, si no, created_by_company_id; esa regla la usa cancel_order().
// A6 Restricciones de coherencia que faltan: quotes.company_id igual a shipments.company_id; quotes.inventory_id del mismo pedido que su envío (inventories.order_id igual a shipments.order_id); company_id de shipment_notes y shipment_events igual al de su envío; jobs sin shipment_id, así que nada impide dos trabajos por envío (añadir shipment_id unique).
// A7 Índice único temporal sobre shipments(order_id) para forzar un envío por pedido en el MVP. Se quita al abrir varias empresas por pedido.
// A8 shipment_events: triggers que bloqueen update y delete, como en audit_log. Solo se inserta desde las funciones que hacen el cambio. note_added guarda solo note_id.
// A9 Número de presupuesto: quotes no tiene columna de número y RF-42 pide que las versiones compartan número. Decidir el prefijo (hoy PR-xxxx en el código) y si el número cuelga del envío o tiene su propia secuencia.
// A10 (POR CONFIRMAR, necesaria para que A1 funcione) Cuándo nace una versión del inventario. El cliente guarda borrador automáticamente (RF-25) y la empresa crea el pedido con direcciones antes de que haya inventario. Si cada edición creara versión, habría decenas. Propuesta: el borrador es la fila de inventories sin submitted_at y se edita en sitio; la versión se cierra al enviar el inventario (submitted_at). Solo editar una versión ya enviada abre un borrador nuevo, que al enviarse es la versión siguiente. Un índice único parcial permite un solo borrador por pedido. Las versiones nuevas copian lo anterior (incluidos los ajustes manuales, A2).
// A11 (POR CONFIRMAR) Qué versión es la vigente de un pedido: la última con submitted_at. Escribirlo como regla (o como vista) para que las pantallas, el cálculo y la lista de envíos no la interpreten cada uno a su manera.
// A12 (POR CONFIRMAR) jobs.quote_id es único y se actualiza si el cliente acepta un presupuesto nuevo antes de la mudanza, así que se pierde qué presupuesto originó el trabajo. Propuesta: dejar el cambio como evento en shipment_events (con el id del presupuesto anterior y del nuevo) en lugar de una tabla nueva.
//
// B. Decisiones abiertas
// B1 (RESUELTO para el MVP el 09/11/2026) Quién cancela un pedido (RF-69): lo cancela su dueño. En el MVP es la empresa creadora y no hay a quién avisar. Con cuentas (fase 3) cancela el cliente y se avisa a las empresas con envío vivo. Ver A4. Sigue abierto si un cliente sin cuenta puede cancelar desde su enlace.
// B2 Nombre shipments. Puede confundirse con transporte de mercancías. Decidirlo antes de crear migraciones: después es caro de cambiar.
// B3 Convención de enums. Las migraciones usan guion en vehicle_type (small-van) y guion bajo en handling_flag (extra_crew). El frontend usa guion (awaiting-inventory) y este DBML guion bajo. Elegir una y mapear en la capa infrastructure si no coinciden.
// B4 Quién lee shipment_notes: solo el administrador (lo asumido) o también el operario.
// B5 inventory_extras apunta a company_extras, que es de cada empresa, y el inventario es del pedido. Opciones: catálogo global de tipos de extra con precio por empresa, o elegir los extras al presupuestar. Bloquea company_extras (paso 2) y la parte de extras del paso 4.
// B6 Qué pasa con los borradores de presupuesto cuando llega una versión nueva del inventario. La regla solo define los presupuestos enviados.
// B7 Caducidad del enlace: RF-15 dice 7 días por defecto y el código tiene 14 (DEFAULT_LINK_VALIDITY_DAYS, con 7, 14 y 30 como opciones). Alinear.
// B8 Notificaciones y recordatorios (RF-18, RF-63): no hay tabla. Decidir si hace falta (tokens push de dispositivos, recordatorios ya enviados).
// B9 Dónde se construye la web del cliente (enlace del pedido). Ver architecture-system.md, sección "Pendiente de decidir".
// B10 (fase 3 o 4, SIN DECIDIR, ningún documento lo define) Qué pasa con las demás empresas cuando una gana un pedido enviado a varias. Lo que sigue es una propuesta del 09/11/2026, no una regla. Hoy lost significa "el cliente no aceptó" (requirement-mvp.md, estados del envío). Mezclar en lost el caso "el cliente eligió a otra empresa" revolvería las métricas de pérdida. Propuesta preferida: un valor nuevo en shipment_status, not_selected, que el sistema asigna a los demás envíos cuando uno pasa a won. Así se miden por separado las pérdidas por rechazo del cliente (lost, con su motivo) y las de comparación (not_selected). Alternativa: mantener lost y distinguir la causa en lost_reason o en el evento, sin valor nuevo. Con cualquiera de las dos: el cambio queda en el historial de cada empresa; reciben una notificación sin saber qué empresa ganó ni su precio (RNF-03); sus presupuestos enviados dejan de poder aceptarse; y una regla (índice único parcial) impide dos envíos won en el mismo pedido. Si se elige not_selected, tampoco se podrá reactivar y habrá que decidir si cuenta como estado final. No se añade al enum shipment_status hasta decidirlo.
// B11 (fase 2 y 3, no se diseña ahora) Penalización o acción especial al cancelar un pedido ya ganado. Cuando se retome: el cobro está fuera del MVP, las condiciones de cancelación tendrían que formar parte de quotes.conditions firmadas por el cliente (consultarlo con un abogado) y convendría guardar en el evento cancelled el importe aceptado, la fecha programada y las horas que faltaban. Como todo pasa por cancel_order(), la regla se añade en un solo sitio.
//
// C. Decididas el 09/11/2026 (ya reflejadas arriba)
// C1 El número visible va en shipments, no en orders. La referencia del cliente (orders.reference) llega con las cuentas.
// C2 orders.token_hash y token_expires_at son nulos hasta que se comparte el enlace, con check de los dos o ninguno.
// C3 Notas e historial en tablas nuevas, shipment_notes y shipment_events. No se usa audit_log: las empresas no pueden leerlo y es inmutable (RGPD).
// C4 shipments tiene status_changed_at y last_activity_at. last_activity_at lo actualiza un trigger de shipment_events. No se añade orders.updated_at.
// C5 Código y rutas: proposals pasa a quotes (inglés) y la interfaz portuguesa usa Orçamentos.
//
// D. Antes de crear las migraciones del paso 4
// D1 Comprobar el historial de migraciones en Supabase. Según una nota de octubre, las del paso 1 se aplicaron a mano y un supabase db push intentaría reaplicarlas (supabase migration repair).
// D2 Partir el paso 4. 4a: clients, orders, shipments, shipment_notes, shipment_events, addresses, inventories e inventory_addresses (sin líneas ni extras), más create_order(), cancel_order() y RLS. Con A1, el texto de origen y destino vive en inventory_addresses, así que inventories e inventory_addresses entran en 4a: create_order() crea la versión 1 en borrador. 4b: inventory_lines, inventory_extras y generación del enlace. 4b espera a A2, A10 y B5.
// D3 Documentación por corregir: borrar o marcar como históricos mudaro-model-es_v1.dbml y requests-model.dbml, que siguen en docs/diagram/. (Ya hecho el 09/11/2026: rutas del DBML, supabase/CLAUDE.md, nota de pedido y envío en apps/company/CLAUDE.md y la decisión de "Orçamentos" en requirement-mvp.md.)
// D4 Impacto en apps/company: renombrar features/proposals a quotes (unos 72 ficheros, 656 líneas, 107 claves por idioma en los diccionarios, ruta /proposals y NavKey), requestId a orderId, pasar OrderStatus y OrderStage a un estado de envío con cancelled, resolver el TODO de "lost", e implementar RF-69.
