# Secretos de las Edge Functions. Solo los nombres: los valores se guardan con `supabase secrets set`.
# SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase en cada función.

# Clave de la API de Resend (empieza por re_)
RESEND_API_KEY=
# Remitente de los convites. Su dominio tiene que estar verificado en Resend. Ejemplo: Mudaro <convites@mudaro.pt>
RESEND_FROM=
# URL base de apps/company, adonde llega el administrador con el enlace del convite.
# En local: http://localhost:3001 (sin barra final ni idioma; la app añade el idioma sola).
COMPANY_APP_URL=
