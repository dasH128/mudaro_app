# App de empresa (apps/company). Copia este archivo a .env.local y rellena los valores.
# Solo variables públicas: nunca pongas aquí la service_role key.

NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Dirección de la web del cliente (apps/client). Solo servidor: con ella se monta el enlace del pedido.
# En local, sin definirla, se usa http://localhost:3003.
CLIENT_APP_URL=http://localhost:3003

# Solo desarrollo: IP del ordenador en la red local, para abrir la app desde el móvil (http://<IP>:3001).
# Sin ella, Next.js bloquea el JavaScript que llega por esa IP y los botones no responden. Varias, separadas por comas.
# ALLOWED_DEV_ORIGINS=192.168.1.20
