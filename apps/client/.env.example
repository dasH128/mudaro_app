# Web del cliente (apps/client). Copia este archivo a .env.local y rellena los valores.
# Solo variables públicas: la clave de servicio vive únicamente en las Edge Functions (RNF-02).
# El servidor de esta app llama a la Edge Function `client-order` de este proyecto.

NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
